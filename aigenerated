-- Function to fetch servers (can refresh if needed)
local function fetchServers(refresh)
    if refresh then
        print("🔄 Refreshing server list...")
        availableServers = {}
        serversFetched = false
    end
    
    if serversFetched then return end
    
    print("🌐 Fetching server list...")
    
    local function getServers(cursor)
        local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?limit=100", placeId)
        if cursor then
            url = url .. "&cursor=" .. cursor
        end
        
        local success, response = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success and response then
            return game:GetService("HttpService"):JSONDecode(response)
        end
        return nil
    end
    
    local servers = {}
    local cursor = nil
    repeat
        local data = getServers(cursor)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    table.insert(servers, server.id)
                end
            end
            cursor = data.nextPageCursor
        else
            break
        end
    until not cursor
    
    availableServers = servers
    serversFetched = true
    hopRetryCount = 0
    print("✓ Found " .. #availableServers .. " available servers")
end

-- Function to set up teleport queue
local function setupTeleportQueue()
    if queue_on_teleport then
        queue_on_teleport([[loadstring(game:HttpGet("]] .. scriptUrl .. [["))()]])
        print("✓ Teleport queue set up successfully")
    else
        print("⚠ queue_on_teleport not available, using fallback method")
        game:GetService("TeleportService").TeleportInitFailed:Connect(function()
            wait(5)
            loadstring(game:HttpGet(scriptUrl))()
        end)
    end
end

-- Server hopping function with retry and refresh
local function serverHop()
    if isServerHopping then return end
    isServerHopping = true
    
    print("🔄 Preparing to server hop...")
    setupTeleportQueue()
    
    -- Ensure we have fresh server list if we've failed before
    if hopRetryCount >= 3 then
        fetchServers(true) -- Force refresh
    elseif not serversFetched or #availableServers == 0 then
        fetchServers(false)
    end
    
    -- Filter out current server
    local validServers = {}
    for _, serverId in ipairs(availableServers) do
        if serverId ~= game.JobId then
            table.insert(validServers, serverId)
        end
    end
    
    if #validServers > 0 then
        local randomServer = validServers[math.random(1, #validServers)]
        print("🚀 Server hopping to: " .. randomServer)
        hopRetryCount = 0
        game:GetService("TeleportService"):TeleportToPlaceInstance(placeId, randomServer, game.Players.LocalPlayer)
    else
        hopRetryCount = hopRetryCount + 1
        local waitTime = math.min(30 * hopRetryCount, 120) -- Progressive backoff
        print("⚠ No other servers available (attempt " .. hopRetryCount .. "), refreshing list and retrying in " .. waitTime .. " seconds...")
        
        isServerHopping = false
        wait(waitTime)
        
        -- Refresh server list and try again
        fetchServers(true)
        serverHop()
    end
end

-- Check if any cubes exist
local function checkForCubes()
    local cubesFound = {}
    
    for _, cubeName in ipairs(cubeNames) do
        local cubeModel = game.Workspace:FindFirstChild(cubeName)
        if cubeModel and cubeModel:IsA("Model") then
            table.insert(cubesFound, cubeName)
        end
    end
    
    return cubesFound
end

-- Function to aggressively collect a cube until it's gone
local function collectCubeUntilGone(cubeName)
    local player = game.Players.LocalPlayer
    if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local humanoidRootPart = player.Character.HumanoidRootPart
    local startTime = tick()
    local maxTime = 10 -- Maximum 10 seconds per cube
    local collectionMethods = {"tp", "bring", "wiggle"}
    local methodIndex = 1
    
    print("🔧 Attempting to collect: " .. cubeName)
    
    while game.Workspace:FindFirstChild(cubeName) and (tick() - startTime) < maxTime do
        local cubeModel = game.Workspace:FindFirstChild(cubeName)
        if not cubeModel then break end
        
        -- Try current method
        if methodIndex == 1 or methodIndex == 2 then -- TP or Bring
            if currentMode == "tp" or (currentMode == "both" and methodIndex == 1) then
                -- TP to cube
                if cubeModel and cubeModel:IsA("Model") then
                    local modelCenter = cubeModel:GetModelCFrame().p
                    humanoidRootPart.CFrame = CFrame.new(modelCenter)
                end
            end
            
            if currentMode == "bring" or (currentMode == "both" and methodIndex == 2) then
                -- Try touch detection
                if cubeModel and cubeModel:IsA("Model") then
                    for _, child in ipairs(cubeModel:GetDescendants()) do
                        if child:IsA("TouchTransmitter") and child.Parent then
                            pcall(function()
                                firetouchinterest(humanoidRootPart, child.Parent, 0)
                                wait(0.05)
                                firetouchinterest(humanoidRootPart, child.Parent, 1)
                            end)
                        end
                    end
                end
            end
        else -- Wiggle method
            if cubeModel and cubeModel:IsA("Model") then
                local modelCenter = cubeModel:GetModelCFrame().p
                -- Wiggle around the cube
                local offsets = {
                    CFrame.new(0, 0, 2),
                    CFrame.new(2, 0, 0),
                    CFrame.new(0, 0, -2),
                    CFrame.new(-2, 0, 0),
                    CFrame.new(0, 2, 0)
                }
                
                for _, offset in ipairs(offsets) do
                    if not game.Workspace:FindFirstChild(cubeName) then break end
                    humanoidRootPart.CFrame = CFrame.new(modelCenter) * offset
                    wait(0.1)
                    
                    -- Try touch detection again
                    for _, child in ipairs(cubeModel:GetDescendants()) do
                        if child:IsA("TouchTransmitter") and child.Parent then
                            pcall(function()
                                firetouchinterest(humanoidRootPart, child.Parent, 0)
                                firetouchinterest(humanoidRootPart, child.Parent, 1)
                            end)
                        end
                    end
                end
            end
        end
        
        -- Cycle through methods every few attempts
        methodIndex = methodIndex + 1
        if methodIndex > 3 then methodIndex = 1 end
        
        wait(0.2)
    end
    
    local success = not game.Workspace:FindFirstChild(cubeName)
    if success then
        print("✅ Successfully collected: " .. cubeName)
    else
        print("⚠ Failed to collect: " .. cubeName .. " (timeout)")
    end
    
    return success
end

-- Cancel hop timer
local function cancelHopTimer()
    if hopTimer then
        hopTimer:Disconnect()
        hopTimer = nil
    end
    hopTimerActive = false
    hopCancelled = true
end

-- Start the 3-second hop timer
local function startHopTimer()
    -- Cancel any existing timer
    cancelHopTimer()
    
    hopTimerActive = true
    hopCancelled = false
    print("⏱️ 3-second timer started - waiting for more cubes...")
    
    -- Small delay to ensure any just-spawned cubes are detected
    wait(0.2)
    
    -- Check if cubes appeared during the delay
    local immediateCubes = checkForCubes()
    if #immediateCubes > 0 and not hopCancelled then
        print("📦 Cubes detected immediately, cancelling timer and collecting...")
        hopTimerActive = false
        collectCubes(immediateCubes)
        return
    end
    
    -- Create new timer
    hopTimer = game:GetService("RunService").Stepped:Connect(function()
        wait(3)
        
        -- Only proceed if timer is still active and not cancelled
        if hopTimerActive and not hopCancelled then
            print("⏱️ 3 seconds passed, checking for cubes...")
            local remainingCubes = checkForCubes()
            
            if #remainingCubes == 0 then
                print("❌ No cubes found after 3 seconds, hopping to new server...")
                hopTimerActive = false
                hopTimer:Disconnect()
                hopTimer = nil
                serverHop()
            else
                print("📦 Found " .. #remainingCubes .. " cube(s) after timer, collecting...")
                hopTimerActive = false
                hopTimer:Disconnect()
                hopTimer = nil
                collectCubes(remainingCubes)
            end
        elseif hopTimer then
            -- Timer was cancelled, clean up
            hopTimer:Disconnect()
            hopTimer = nil
        end
    end)
end

-- Main collection function
local function collectCubes(cubesToCollect)
    if collectionActive then return end
    collectionActive = true
    
    cancelHopTimer()
    
    print("🔍 Starting collection of " .. #cubesToCollect .. " cube(s)...")
    
    local failedCubes = {}
    
    for _, cubeName in ipairs(cubesToCollect) do
        if game.Workspace:FindFirstChild(cubeName) then
            -- Try to collect until it's gone
            local success = collectCubeUntilGone(cubeName)
            
            if not success and game.Workspace:FindFirstChild(cubeName) then
                table.insert(failedCubes, cubeName)
            end
            
            wait(0.1)
        end
    end
    
    -- Retry failed cubes with more aggressive method
    if #failedCubes > 0 then
        print("🔄 Aggressively retrying " .. #failedCubes .. " failed cube(s)...")
        wait(0.5)
        
        for _, cubeName in ipairs(failedCubes) do
            if game.Workspace:FindFirstChild(cubeName) then
                print("⚡ Aggressive collection for: " .. cubeName)
                
                -- More aggressive: TP and wiggle simultaneously
                local cubeModel = game.Workspace:FindFirstChild(cubeName)
                if cubeModel and cubeModel:IsA("Model") then
                    local modelCenter = cubeModel:GetModelCFrame().p
                    local player = game.Players.LocalPlayer
                    
                    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = player.Character.HumanoidRootPart
                        
                        -- Rapid TP and touch attempts
                        for i = 1, 5 do
                            if not game.Workspace:FindFirstChild(cubeName) then break end
                            
                            hrp.CFrame = CFrame.new(modelCenter)
                            wait(0.05)
                            
                            for _, child in ipairs(cubeModel:GetDescendants()) do
                                if child:IsA("TouchTransmitter") and child.Parent then
                                    pcall(function()
                                        firetouchinterest(hrp, child.Parent, 0)
                                        firetouchinterest(hrp, child.Parent, 1)
                                    end)
                                end
                            end
                            
                            wait(0.05)
                        end
                    end
                end
            end
            wait(0.1)
        end
    end
    
    wait(0.3)
    local remainingCubes = checkForCubes()
    
    if #remainingCubes > 0 then
        print("🔄 Found " .. #remainingCubes .. " more cube(s), continuing collection...")
        collectionActive = false
        collectCubes(remainingCubes)
    else
        print("✅ All cubes collected, starting 3-second timer for new spawns...")
        collectionActive = false
        startHopTimer()
    end
end

-- Wait for game to be fully loaded
local function waitForGameLoad()
    repeat wait() until game.Players.LocalPlayer
    if not game.Players.LocalPlayer.Character then
        game.Players.LocalPlayer.CharacterAdded:Wait()
    end
    repeat wait() until game.Workspace
end

-- Handle new cube detection
local function onNewCubeDetected(cubeName)
    if hopTimerActive and not hopCancelled then
        print("🛑 Hop cancelled - new cube detected: " .. cubeName)
        cancelHopTimer()
        
        local cubesFound = checkForCubes()
        if #cubesFound > 0 then
            collectCubes(cubesFound)
        end
    elseif not collectionActive and gameInitialized then
        local cubesFound = checkForCubes()
        if #cubesFound > 0 then
            print("📦 New cube detected while idle, collecting...")
            collectCubes(cubesFound)
        end
    end
end

-- Monitor for new cube spawns
game:GetService("Workspace").ChildAdded:Connect(function(child)
    for _, cubeName in ipairs(cubeNames) do
        if child.Name == cubeName then
            onNewCubeDetected(cubeName)
            break
        end
    end
end)

-- Main initialization
local function initialize()
    print("⚙️ Initializing Tycoon RNG Auto Collector...")
    print("✓ TP to Cubes: ON")
    print("✓ Bring Cubes: ON")
    print("✓ Server Hop: ON")
    print("Mode: " .. currentMode)
    
    -- Fetch servers ONCE at startup
    fetchServers(false)
    
    print("================================")
    
    waitForGameLoad()
    
    print("🔍 Scanning for cubes to confirm game initialization...")
    while not gameInitialized do
        local cubesFound = checkForCubes()
        if #cubesFound > 0 then
            gameInitialized = true
            print("✓ Game initialized! Found " .. #cubesFound .. " cube(s)")
            print("🚀 Starting collection process...")
            
            collectCubes(cubesFound)
        else
            wait(1)
        end
    end
    
    -- Anti-afk thread
    coroutine.wrap(function()
        while true do
            local player = game.Players.LocalPlayer
            if player and player.Character then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid.Jump = true
                    humanoid.Jump = false
                end
            end
            wait(300)
        end
    end)()
    
    -- Character respawn handler
    game.Players.LocalPlayer.CharacterAdded:Connect(function()
        print("👤 Character respawned")
        wait(1)
        if gameInitialized then
            local cubesFound = checkForCubes()
            if #cubesFound > 0 then
                print("📦 Found cubes after respawn, collecting...")
                collectCubes(cubesFound)
            else
                print("⏱️ No cubes after respawn, starting timer...")
                startHopTimer()
            end
        end
    end)
end

-- Start the script
initialize()
