-- Function to collect a single cube until it's gone (with proper delays)
local function collectSingleCube(cubeName)
    local player = game.Players.LocalPlayer
    if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local humanoidRootPart = player.Character.HumanoidRootPart
    local startTime = tick()
    local maxTime = 10 -- Maximum 10 seconds per cube
    local lastTPTime = 0
    local lastWiggleTime = 0
    local collected = false
    
    print("🔧 Attempting to collect: " .. cubeName)
    
    -- First, teleport to the cube and wait a moment
    local cubeModel = game.Workspace:FindFirstChild(cubeName)
    if cubeModel and cubeModel:IsA("Model") then
        local modelCenter = cubeModel:GetModelCFrame().p
        humanoidRootPart.CFrame = CFrame.new(modelCenter)
        wait(0.5) -- Wait after first teleport
    end
    
    while game.Workspace:FindFirstChild(cubeName) and (tick() - startTime) < maxTime do
        local cubeModel = game.Workspace:FindFirstChild(cubeName)
        if not cubeModel then break end
        
        local currentTime = tick()
        
        -- TP to cube every 1.5 seconds (slower to avoid multiple cube TP)
        if currentTime - lastTPTime >= 1.5 then
            if cubeModel and cubeModel:IsA("Model") then
                local modelCenter = cubeModel:GetModelCFrame().p
                humanoidRootPart.CFrame = CFrame.new(modelCenter)
                lastTPTime = currentTime
                wait(0.3) -- Wait after TP
            end
        end
        
        -- Try touch detection (but not too frequently)
        if cubeModel and cubeModel:IsA("Model") then
            for _, child in ipairs(cubeModel:GetDescendants()) do
                if child:IsA("TouchTransmitter") and child.Parent then
                    pcall(function()
                        firetouchinterest(humanoidRootPart, child.Parent, 0)
                        wait(0.1)
                        firetouchinterest(humanoidRootPart, child.Parent, 1)
                    end)
                end
            end
            wait(0.3) -- Wait after touch attempts
        end
        
        -- Gentle wiggle every 3 seconds
        if currentTime - lastWiggleTime >= 3.0 then
            if cubeModel and cubeModel:IsA("Model") then
                local modelCenter = cubeModel:GetModelCFrame().p
                
                -- Small 0.5 stud movements
                local offsets = {
                    CFrame.new(0.5, 0, 0),
                    CFrame.new(-0.5, 0, 0),
                }
                
                for _, offset in ipairs(offsets) do
                    if not game.Workspace:FindFirstChild(cubeName) then break end
                    humanoidRootPart.CFrame = CFrame.new(modelCenter) * offset
                    wait(0.3)
                    
                    -- Try touch detection during wiggle
                    for _, child in ipairs(cubeModel:GetDescendants()) do
                        if child:IsA("TouchTransmitter") and child.Parent then
                            pcall(function()
                                firetouchinterest(humanoidRootPart, child.Parent, 0)
                                firetouchinterest(humanoidRootPart, child.Parent, 1)
                            end)
                        end
                    end
                    wait(0.2)
                end
                
                -- Return to center
                if game.Workspace:FindFirstChild(cubeName) then
                    humanoidRootPart.CFrame = CFrame.new(modelCenter)
                end
                
                lastWiggleTime = currentTime
            end
        end
        
        -- Check if cube was collected
        if not game.Workspace:FindFirstChild(cubeName) then
            collected = true
            incrementCounter(cubeName) -- Increment counter when collected
            break
        end
        
        wait(0.5) -- Main loop delay
    end
    
    -- Double-check if cube was collected at the end
    if not collected and not game.Workspace:FindFirstChild(cubeName) then
        collected = true
        incrementCounter(cubeName)
    end
    
    if collected then
        print("✅ Successfully collected: " .. cubeName)
    else
        print("⚠ Failed to collect: " .. cubeName .. " (timeout)")
    end
    
    return collected
end

-- Cancel hop timer (simplified)
local function cancelHopTimer()
    hopTimer = nil
    hopTimerActive = false
    hopCancelled = true
end

-- Start the 3-second hop timer (simplified)
local function startHopTimer()
    -- Cancel any existing timer
    cancelHopTimer()
    
    -- If server hopping is disabled, don't start timer, just keep scanning
    if not SERVER_HOP_ENABLED then
        print("⏸️ Server hopping disabled - continuously scanning for cubes...")
        spawn(function()
            while true do
                wait(3) -- Check every 3 seconds
                if not collectionActive and gameInitialized then
                    local cubesFound = checkForCubes()
                    if #cubesFound > 0 then
                        print("📦 Found cubes while scanning, collecting...")
                        collectCubes(cubesFound)
                    end
                end
                wait(1)
            end
        end)
        return
    end
    
    hopTimerActive = true
    hopCancelled = false
    print("⏱️ 3-second timer started - waiting for more cubes...")
    
    -- Small delay to ensure any just-spawned cubes are detected
    wait(0.2)
    
    -- Check if cubes appeared during the delay
    local immediateCubes = checkForCubes()
    if #immediateCubes > 0 and not hopCancelled then
        print("📦 Cubes detected immediately, cancelling timer and collecting...")
        hopTimerActive = false
        collectCubes(immediateCubes)
        return
    end
    
    -- Simple timer using spawn
    spawn(function()
        wait(3)
        
        -- Only proceed if timer is still active and not cancelled
        if hopTimerActive and not hopCancelled then
            print("⏱️ 3 seconds passed, checking for cubes...")
            local remainingCubes = checkForCubes()
            
            if #remainingCubes == 0 then
                print("❌ No cubes found after 3 seconds" .. (SERVER_HOP_ENABLED and ", hopping to new server..." or ", continuing to scan..."))
                hopTimerActive = false
                if SERVER_HOP_ENABLED then
                    serverHop()
                else
                    -- Just restart the scan
                    startHopTimer()
                end
            else
                print("📦 Found " .. #remainingCubes .. " cube(s) after timer, collecting...")
                hopTimerActive = false
                collectCubes(remainingCubes)
            end
        end
    end)
end

-- Main collection function (processes ONE cube at a time)
local function collectCubes(cubesToCollect)
    if collectionActive then return end
    collectionActive = true
    
    cancelHopTimer()
    
    print("🔍 Starting collection of " .. #cubesToCollect .. " cube(s) - processing ONE at a time...")
    
    local failedCubes = {}
    
    -- Process each cube ONE AT A TIME with delays between
    for index, cubeName in ipairs(cubesToCollect) do
        if game.Workspace:FindFirstChild(cubeName) then
            print("📦 Processing cube " .. index .. "/" .. #cubesToCollect .. ": " .. cubeName)
            
            -- Focus on this ONE cube until it's collected or times out
            local success = collectSingleCube(cubeName)
            
            if not success and game.Workspace:FindFirstChild(cubeName) then
                table.insert(failedCubes, cubeName)
                print("⚠ Will retry " .. cubeName .. " later")
            end
            
            -- CRITICAL: Wait between cubes to prevent multiple cube TP
            print("⏱️ Waiting 1 second before next cube...")
            wait(1.0)
        end
    end
    
    -- If there are failed cubes, retry them ONE AT A TIME
    if #failedCubes > 0 then
        print("🔄 Retrying " .. #failedCubes .. " failed cube(s) one at a time...")
        wait(1.5) -- Longer wait before retry batch
        
        for index, cubeName in ipairs(failedCubes) do
            if game.Workspace:FindFirstChild(cubeName) then
                print("⚡ Retry " .. index .. "/" .. #failedCubes .. ": " .. cubeName)
                
                -- Focus on this ONE cube again
                local cubeModel = game.Workspace:FindFirstChild(cubeName)
                if cubeModel and cubeModel:IsA("Model") then
                    local modelCenter = cubeModel:GetModelCFrame().p
                    local player = game.Players.LocalPlayer
                    
                    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = player.Character.HumanoidRootPart
                        
                        -- TP to center
                        hrp.CFrame = CFrame.new(modelCenter)
                        wait(1.0)
                        
                        -- Try touch detection a few times with delays
                        for i = 1, 3 do
                            if not game.Workspace:FindFirstChild(cubeName) then break end
                            
                            for _, child in ipairs(cubeModel:GetDescendants()) do
                                if child:IsA("TouchTransmitter") and child.Parent then
                                    pcall(function()
                                        firetouchinterest(hrp, child.Parent, 0)
                                        wait(0.2)
                                        firetouchinterest(hrp, child.Parent, 1)
                                    end)
                                end
                            end
                            
                            -- Check if collected during retry
                            if not game.Workspace:FindFirstChild(cubeName) then
                                incrementCounter(cubeName)
                                break
                            end
                            
                            wait(0.5) -- Wait between touch attempts
                        end
                    end
                end
                
                -- Wait between retry cubes
                if index < #failedCubes then
                    wait(1.0)
                end
            end
        end
    end
    
    -- After all cubes processed, check for any new ones
    wait(1.0)
    local remainingCubes = checkForCubes()
    
    if #remainingCubes > 0 then
        print("🔄 Found " .. #remainingCubes .. " more cube(s), continuing collection one at a time...")
        collectionActive = false
        collectCubes(remainingCubes)
    else
        print("✅ All cubes collected, starting 3-second timer for new spawns...")
        collectionActive = false
        startHopTimer()
    end
end

