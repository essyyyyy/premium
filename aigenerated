-- Function to set up teleport queue
local function setupTeleportQueue()
    if queue_on_teleport then
        queue_on_teleport([[loadstring(game:HttpGet("]] .. scriptUrl .. [["))()]])
        print("✓ Teleport queue set up successfully")
    else
        print("⚠ queue_on_teleport not available, using fallback method")
        game:GetService("TeleportService").TeleportInitFailed:Connect(function()
            wait(5)
            loadstring(game:HttpGet(scriptUrl))()
        end)
    end
end

-- Server hopping function
local function serverHop()
    if isServerHopping then return end
    isServerHopping = true
    
    setupTeleportQueue()
    
    local function getServers(cursor)
        local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?limit=100", placeId)
        if cursor then
            url = url .. "&cursor=" .. cursor
        end
        
        local success, response = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success and response then
            return game:GetService("HttpService"):JSONDecode(response)
        end
        return nil
    end
    
    local servers = {}
    local cursor = nil
    repeat
        local data = getServers(cursor)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    table.insert(servers, server.id)
                end
            end
            cursor = data.nextPageCursor
        else
            break
        end
    until not cursor
    
    if #servers > 0 then
        local randomServer = servers[math.random(1, #servers)]
        print("Server hopping to: " .. randomServer)
        game:GetService("TeleportService"):TeleportToPlaceInstance(placeId, randomServer, game.Players.LocalPlayer)
    else
        print("No other servers available, retrying...")
        isServerHopping = false
        serverHop()
    end
end

-- Check if any cubes exist
local function checkForCubes()
    local cubesFound = {}
    
    for _, cubeName in ipairs(cubeNames) do
        local cubeModel = game.Workspace:FindFirstChild(cubeName)
        if cubeModel and cubeModel:IsA("Model") then
            table.insert(cubesFound, cubeName)
        end
    end
    
    return cubesFound
end

-- TP to cubes function
local function teleportToCube(cubeName)
    local player = game.Players.LocalPlayer
    
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local humanoidRootPart = player.Character.HumanoidRootPart
        local cubeModel = game.Workspace:FindFirstChild(cubeName)
        
        if cubeModel and cubeModel:IsA("Model") then
            local modelCenter = cubeModel:GetModelCFrame().p
            humanoidRootPart.CFrame = CFrame.new(modelCenter)
            print("Teleported to: " .. cubeName)
            return true
        end
    end
    return false
end

-- Bring cubes function (fire touch detectors)
local function bringCube(cubeName)
    local player = game.Players.LocalPlayer
    if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local humanoidRootPart = player.Character.HumanoidRootPart
    local cubeModel = game.Workspace:FindFirstChild(cubeName)
    
    if cubeModel and cubeModel:IsA("Model") then
        for _, child in ipairs(cubeModel:GetDescendants()) do
            if child:IsA("TouchTransmitter") then
                firetouchinterest(humanoidRootPart, child.Parent, 0)
                firetouchinterest(humanoidRootPart, child.Parent, 1)
                print("Collected: " .. cubeName)
                return true
            end
        end
    end
    return false
end

-- Start the 3-second hop timer
local function startHopTimer()
    if hopTimer then
        hopTimer:Disconnect()
        hopTimer = nil
    end
    
    hopCancelled = false
    print("⏱️ 3-second timer started - waiting for more cubes...")
    
    hopTimer = game:GetService("RunService").Stepped:Connect(function()
        wait(3)
        if hopTimer and not hopCancelled then
            print("⏱️ 3 seconds passed, checking if any cubes remain...")
            local remainingCubes = checkForCubes()
            
            if #remainingCubes == 0 then
                print("No cubes remaining, hopping to new server...")
                hopTimer:Disconnect()
                hopTimer = nil
                serverHop()
            else
                print("Cubes still exist, continuing collection...")
                hopTimer:Disconnect()
                hopTimer = nil
                -- Continue collecting remaining cubes
                collectCubes(remainingCubes)
            end
        end
    end)
end

-- Main collection function
local function collectCubes(cubesToCollect)
    for _, cubeName in ipairs(cubesToCollect) do
        -- Check if hop was cancelled
        if hopCancelled then
            break
        end
        
        -- Collect the cube based on mode
        if currentMode == "tp" or currentMode == "both" then
            teleportToCube(cubeName)
        end
        
        if currentMode == "bring" or currentMode == "both" then
            bringCube(cubeName)
        end
        
        -- Small delay to ensure collection registers
        wait(0.1)
    end
    
    -- After collecting, check if there are more cubes
    if not hopCancelled then
        local remainingCubes = checkForCubes()
        if #remainingCubes > 0 then
            print("Found more cubes after collection, continuing...")
            collectCubes(remainingCubes)
        else
            -- Start the 3-second timer for potential new cubes
            startHopTimer()
        end
    end
end

-- Wait for game to be fully loaded
local function waitForGameLoad()
    repeat wait() until game.Players.LocalPlayer
    if not game.Players.LocalPlayer.Character then
        game.Players.LocalPlayer.CharacterAdded:Wait()
    end
    repeat wait() until game.Workspace
end

-- Main initialization and loop
local function initialize()
    print("=== Tycoon RNG Auto Collector ===")
    print("✓ TP to Cubes: ON")
    print("✓ Bring Cubes: ON")
    print("✓ Server Hop: ON")
    print("Mode: " .. currentMode)
    print("Script URL: " .. scriptUrl)
    print("================================")
    
    -- Wait for basic game elements
    waitForGameLoad()
    
    -- Keep checking until we see at least 1 cube (game initialized)
    print("🔍 Scanning for cubes to confirm game initialization...")
    while not gameInitialized do
        local cubesFound = checkForCubes()
        if #cubesFound > 0 then
            gameInitialized = true
            print("✓ Game initialized! Found " .. #cubesFound .. " cube(s)")
            print("Starting collection...")
            
            -- Start collecting the cubes we found
            collectCubes(cubesFound)
        else
            -- No cubes yet, keep waiting and scanning
            wait(1)
        end
    end
    
    -- Start anti-afk in separate thread
    coroutine.wrap(function()
        while true do
            local player = game.Players.LocalPlayer
            if player and player.Character then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid.Jump = true
                    humanoid.Jump = false
                end
            end
            wait(300)
        end
    end)()
    
    -- Character respawn handler
    game.Players.LocalPlayer.CharacterAdded:Connect(function()
        wait(0.1)
        if gameInitialized then
            -- Resume collection if game was already initialized
            local cubesFound = checkForCubes()
            if #cubesFound > 0 then
                collectCubes(cubesFound)
            end
        end
    end)
end

-- Handle hop cancellation from new cube discoveries
local function onNewCubeDetected()
    if hopTimer and not hopCancelled then
        hopCancelled = true
        hopTimer:Disconnect()
        hopTimer = nil
        print("🛑 Hop cancelled - new cube detected!")
        
        -- Collect the new cubes
        local cubesFound = checkForCubes()
        if #cubesFound > 0 then
            collectCubes(cubesFound)
        end
    end
end

-- Monitor for new cube spawns
game:GetService("Workspace").ChildAdded:Connect(function(child)
    for _, cubeName in ipairs(cubeNames) do
        if child.Name == cubeName then
            onNewCubeDetected()
            break
        end
    end
end)

-- Start the script
initialize()
