local counterEnabled = true

-- Function to load counter from file
local function loadCounter()
    -- Try different executor file read methods
    local success, data = pcall(function()
        if readfile then
            return readfile(counterFile)
        elseif isfile and readfile then
            return readfile(counterFile)
        end
        return nil
    end)
    
    if success and data then
        local success, decoded = pcall(function()
            return game:GetService("HttpService"):JSONDecode(data)
        end)
        if success and decoded then
            collectionCounts = decoded.counts or {}
            totalCollected = decoded.total or 0
            print("📊 Loaded counter: " .. totalCollected .. " total cubes collected")
            return
        end
    end
    
    -- Initialize new counter
    collectionCounts = {}
    for _, name in ipairs(cubeNames) do
        collectionCounts[name] = 0
    end
    totalCollected = 0
    print("📊 Started new counter")
end

-- Function to save counter to file
local function saveCounter()
    local data = {
        counts = collectionCounts,
        total = totalCollected
    }
    
    local success, encoded = pcall(function()
        return game:GetService("HttpService"):JSONEncode(data)
    end)
    
    if success and encoded then
        pcall(function()
            if writefile then
                writefile(counterFile, encoded)
            end
        end)
    end
end

-- Function to increment counter for a cube
local function incrementCounter(cubeName)
    if not collectionCounts[cubeName] then
        collectionCounts[cubeName] = 0
    end
    collectionCounts[cubeName] = collectionCounts[cubeName] + 1
    totalCollected = totalCollected + 1
    
    -- Save to file
    saveCounter()
    
    -- Update GUI if it exists
    if counterGui and counterGui.Enabled then
        updateCounterDisplay()
    end
    
    print("📊 +1 " .. cubeName .. " (Total: " .. totalCollected .. ")")
end

